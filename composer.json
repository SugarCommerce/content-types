{
  "name": "sugarcommerce/content-types",
  "description": "Register WordPress post types and taxonomies from their singular names, with every label written in their own words.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/content-types",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\ContentTypes\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/content-types/issues",
    "source": "https://github.com/sugarcommerce/content-types"
  },
  "keywords": [
    "wordpress",
    "post-types",
    "taxonomies",
    "labels"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\ContentTypes\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/Core/bootstrap.php",
      "/tests/Core/wp-tests-config.php"
    ]
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:core"
    ],
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "test:unit": "phpunit",
    "test:core": "phpunit -c phpunit-core.xml.dist"
  }
}
